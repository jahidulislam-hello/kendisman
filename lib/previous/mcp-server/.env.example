# Supabase project that holds Fitzella data (same project as the app).
SUPABASE_URL=https://ifqohqltbqslqvdqwokg.supabase.co

# SERVICE-ROLE key. Server-only secret — bypasses RLS, so the server scopes every
# query to the token-resolved user by hand. NEVER expose this to any client, and
# never put it in a NEXT_PUBLIC_* var.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Rate limit per token (fixed window). Optional; defaults shown.
MCP_RATE_LIMIT=60
MCP_RATE_WINDOW_SECONDS=60
